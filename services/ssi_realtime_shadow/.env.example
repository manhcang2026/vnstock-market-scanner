# SSI FCData credentials - NEVER commit the real values.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_AUTH_TYPE=Bearer
SSI_URL=https://fc-data.ssi.com.vn/
SSI_STREAM_URL=https://fc-datahub.ssi.com.vn/
SSI_CHANNEL=X:ALL

# Read-only universe source. Use the publishable/anon key, NOT service-role.
SUPABASE_URL=
SUPABASE_KEY=

# Optional: if set and file exists, this overrides Supabase universe loading.
UNIVERSE_FILE=
MIN_UNIVERSE_SIZE=700

DATABASE_PATH=data/ssi_shadow.db
STALE_STREAM_SECONDS=180
COMMIT_EVERY_EVENTS=500
COMMIT_EVERY_SECONDS=1
LOG_LEVEL=INFO

# CCC V2 realtime volume shadow. Disabled by default; baseline is read-only.
VOLUME_ENGINE_ENABLED=false
LIVE_STATE_ENABLED=false
VOLUME_BASELINE_PATH=data/ccc_v2_baseline.db
MARKET_V2_DATABASE_PATH=data/ccc_market_v2.db
SSI_HISTORY_PATH=data/ssi_history_2026.db
VOLUME_SHADOW_SYMBOLS=HPG,SHS,VGI

# Optional PostgreSQL shadow writer. Disabled by default; SQLite remains canonical.
# The temporary target may be Supabase PostgreSQL. The production target is
# ordinary PostgreSQL on Oracle VPS, using the same direct DSN configuration.
# This DSN is server-only and must never be exposed to browser/frontend code.
POSTGRES_SHADOW_ENABLED=false
POSTGRES_SHADOW_DSN=
POSTGRES_SHADOW_FLUSH_SECONDS=1
POSTGRES_SHADOW_BATCH_SIZE=500
POSTGRES_SHADOW_QUEUE_SIZE=10000
